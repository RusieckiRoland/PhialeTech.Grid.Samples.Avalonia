<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PhialeTech.Grid.Samples.Avalonia.DataVirtualization</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PhialeTech.Grid.Contracts" Version="$(PhialeGridVersion)" />
    <PackageReference Include="PhialeTech.Grid.Core" Version="$(PhialeGridVersion)" />
    <PackageReference Include="PhialeTech.Grid.Avalonia" Version="$(PhialeGridVersion)" />
    <PackageReference Include="Phiale.Design.Avalonia" Version="$(PhialeDesignAvaloniaVersion)" />
    <PackageReference Include="UniversalInput.Contracts" Version="3.0.0-preview.3" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.15" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <Content Include="../../Data/warehouse-1000000.sqlite" Link="Data/warehouse-1000000.sqlite" CopyToOutputDirectory="PreserveNewest" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="8.0.34" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <Compile Include="../01-SqliteBinding/Models/StockRow.cs" Link="Models/StockRow.cs" />
    <Compile Include="../03-HttpRest/Server/WarehouseDbContext.cs" Link="Infrastructure/Queries/WarehouseDbContext.cs" />
    <Compile Include="../03-HttpRest/Server/StockQuery.cs" Link="Infrastructure/Queries/StockQuery.cs" />
    <Compile Include="../03-HttpRest/Server/StockReadRow.cs" Link="Infrastructure/Queries/StockReadRow.cs" />
    <Compile Include="../03-HttpRest/Server/StockFilters.cs" Link="Infrastructure/Queries/StockFilters.cs" />
    <Compile Include="../03-HttpRest/Server/StockSorting.cs" Link="Infrastructure/Queries/StockSorting.cs" />
    <Compile Include="../03-HttpRest/Server/PredicateComposer.cs" Link="Infrastructure/Queries/PredicateComposer.cs" />
    <Compile Include="../03-HttpRest/Server/EfStockRepository.cs" Link="Infrastructure/Queries/EfStockRepository.cs" />
    <Compile Include="../04-ServerGrouping/Server/GroupedStockRepository.cs" Link="Infrastructure/Groups/GroupedStockRepository.cs" />
    <Compile Include="../04-ServerGrouping/Server/GroupCatalog.cs" Link="Infrastructure/Groups/GroupCatalog.cs" />
    <Compile Include="../04-ServerGrouping/Server/GroupLayout.cs" Link="Infrastructure/Groups/GroupLayout.cs" />
    <Compile Include="../04-ServerGrouping/Server/GroupContract.cs" Link="Infrastructure/Groups/GroupContract.cs" />
  <Compile Include="../03-HttpRest/Server/StockPage.cs" Link="Infrastructure/Queries/StockPage.cs" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="11.3.7" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.7" />
  </ItemGroup>
</Project>
