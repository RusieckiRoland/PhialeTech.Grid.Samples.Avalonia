<Application
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="PhialeTech.Grid.Samples.Avalonia.SqliteBinding.App"
    RequestedThemeVariant="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude
                    Source="avares://Phiale.Design.Avalonia/Themes/Palette.axaml" />
                <ResourceInclude
                    Source="avares://Phiale.Design.Avalonia/Themes/Controls.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude
            Source="avares://PhialeGrid.Styles.Avalonia/Themes/Generic.axaml" />
        <StyleInclude
            Source="/Common/SampleStyles.axaml" />
    </Application.Styles>
</Application>