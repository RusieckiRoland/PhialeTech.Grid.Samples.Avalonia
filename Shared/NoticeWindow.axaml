<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="PhialeTech.Grid.Samples.Avalonia.Common.NoticeWindow"
    Width="520"
    Height="230"
    CanResize="False"
    WindowStartupLocation="CenterOwner">
    <DockPanel
        Margin="20">
        <TextBlock
            DockPanel.Dock="Top"
            Text="{Binding Heading}"
            FontSize="18"
            FontWeight="SemiBold"
            Margin="0,0,0,12" />
        <StackPanel
            DockPanel.Dock="Bottom"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8"
            Margin="0,16,0,0">
            <Button
                x:Name="SaveChoice"
                Content="Zapisz"
                Height="36"
                MinWidth="96"
                Theme="{StaticResource Phiale.Design.Style.Button.Primary}" />
            <Button
                x:Name="DiscardChoice"
                Content="Odrzuć"
                Height="36"
                MinWidth="96" />
            <Button
                x:Name="CancelChoice"
                Content="Anuluj"
                Height="36"
                MinWidth="96" />
        </StackPanel>
        <TextBlock
            Text="{Binding Message}"
            TextWrapping="Wrap" />
    </DockPanel>
</Window>